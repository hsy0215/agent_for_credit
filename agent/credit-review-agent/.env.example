# Copy to .env or export in the shell. Never commit the real value.
DEEPSEEK_API_KEY=replace-with-your-key

# Optional: when port 1234 is an SSH reverse tunnel to a local HTTP proxy
# (for example local Clash HTTP proxy port 7890), keep the DeepSeek base_url
# unchanged and route outbound HTTP(S) traffic through the tunnel.
HTTP_PROXY=http://127.0.0.1:1234
HTTPS_PROXY=http://127.0.0.1:1234
